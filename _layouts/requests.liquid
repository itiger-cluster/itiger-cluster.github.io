---
layout: default
---
<div class="post">
  <header class="post-header">
    <h1 class="post-title">{{ page.title }}</h1>
    <p class="post-description">{{ page.description }}</p>
  </header>

<div class="container">
<center>
<iframe title="iTiger user registration form" src="https://forms.cloud.microsoft/Pages/ResponsePage.aspx?id=6loUrrLNakSwWnhY3eXduvO9K9fMvv9KnPbfdDF0RuRUQVhLSUJNNlJaUkdaUU4xVEtSRVU4R0YzMC4u&embed=true" width="100%" height="900" style="border: none; width: 100%; height: 85vh; min-height: 600px;" allowfullscreen> </iframe>
</center>
</div>


  <article>
    {{ content }}
  </article>


  {% if page.related_publications %}
    <h2>References</h2>
    <div class="publications">
      {% bibliography --cited_in_order %}
    </div>
  {% endif %}

  {% if site.giscus and page.giscus_comments %}
    {% include giscus.liquid %}
  {% endif %}
</div>
